# ==============================================================================
# VAULTX Banking Simulation Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your local or cloud setup.
# NEVER commit your actual .env file or real DATABASE_URL password to Git.

# Host address to bind the HTTP server (use 0.0.0.0 for public/docker, 127.0.0.1 for local only)
HOST=0.0.0.0

# Port number to listen on
PORT=8080

# Supabase / PostgreSQL Connection String (required)
# Use sslmode=require for Supabase cloud connections.
DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Path to the directory containing static HTML/CSS/JS frontend assets
FRONTEND_DIR=./frontend

# Security: Allowed CORS origin(s) (comma-separated). Defaults to production Vercel URL.
ALLOWED_ORIGIN=https://vaultx-five-rosy.vercel.app

# Security: Demo accounts are disabled by default (set to true only for local testing)
ENABLE_DEMO_ACCOUNTS=false

# Security: Trusted proxy mode (none | render | cloudflare). Defaults to none (remote_addr).
TRUST_PROXY=none
